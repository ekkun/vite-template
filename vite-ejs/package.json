{
  "name": "vite-ejs-template",
  "description": "Vite + ejs + Sass",
  "version": "1.5.0",
  "keywords": [
    "Vite",
    "ejs",
    "scss"
  ],
  "author": "e@oshinco.com",
  "license": "Oshinco Co-op",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "pnpm images:start && pnpm lint && vite --mode watch",
    "start": "pnpm dev",
    "preview": "pnpm images:start && pnpm lint && vite preview --mode production ",
    "test": "node --test ../tests/template-contract.test.mjs",
    "build:dev": "pnpm clean:dist && vite build --mode development && pnpm html && pnpm images:build && pnpm style:media && pnpm style:process",
    "build:prod": "pnpm clean:dist && vite build --mode production && pnpm html && pnpm images:build && pnpm style:media && pnpm style:process",
    "build": "pnpm build:prod",
    "deploy": "",
    "html": "node htmlBeautify.mjs",
    "html:lint": "markuplint \"src/**/{*.ejs,*.html}\"",
    "style:lint": "",
    "style:media": "node mediaQueries.mjs",
    "style:process": "node processCssFiles.mjs",
    "es:lint": "eslint \"src/js/**/*.js\"",
    "lint": "pnpm es:lint --fix",
    "images:build": "node convertImage.mjs -i ./src/images -o ./dist/assets/images -m -w -t -v",
    "images:start": "node convertImage.mjs -i ./src/images -o ./src/public/assets/images -m -w -t -v",
    "images:start_": "node convertImage.mjs -i ./src/images -o ./.pnpm/temp/public/assets/images -m -w -t -v",
    "symlinks": "node createSymlink.mjs",
    "clean:cache": "pnpm store prune",
    "clean:dist": "rimraf dist",
    "clean:node": "rimraf node_modules",
    "clean:all": "pnpm clean:cache && pnpm clean:dist && pnpm clean:node",
    "update:list": "pnpm outdated",
    "update:dev": "pnpm update",
    "update:all": "pnpm update -L"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@markuplint/ejs-parser": "^5.3.0",
    "autoprefixer": "^10.6.1",
    "commander": "^15.0.0",
    "css-declaration-sorter": "^7.4.0",
    "ejs": "^7.0.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "fs-extra": "^11.4.1",
    "glob": "^13.0.6",
    "globals": "^17.13.0",
    "js-beautify": "^2.0.3",
    "markuplint": "^5.3.0",
    "postcss": "^8.5.31",
    "postcss-merge-at-rules": "^2.0.1",
    "postcss-normalize-charset": "^9.0.6",
    "postcss-sort-media-queries": "^6.7.1",
    "rimraf": "^6.1.3",
    "sass": "^1.106.1",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "vite": "^8.3.5",
    "vite-plugin-ejs": "^2.0.0",
    "vite-plugin-live-reload": "^4.0.0"
  },
  "dependencies": {
    "kiso.css": "^1.2.4"
  },
  "browserslist": [
    "last 3 versions"
  ],
  "comments": {
    "security issues": "pnpm audit --audit-level high, (Low、Moderate、High、Critical)",
    "NOTE": ""
  }
}
