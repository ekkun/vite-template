{
  "name": "vite-react-template",
  "description": "Vite + React + Sass",
  "version": "1.5.0",
  "keywords": [
    "Vite",
    "react",
    "scss"
  ],
  "author": "e@oshinco.com",
  "license": "Oshinco Co-op",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test ../tests/template-contract.test.mjs",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "clean:cache": "pnpm store prune",
    "clean:dist": "rm -rf dist",
    "clean:node": "rm -rf node_modules",
    "clean:all": "pnpm clean:cache && pnpm clean:dist && pnpm clean:node",
    "update:list": "pnpm outdated",
    "update:dev": "pnpm update",
    "update:all": "pnpm update -L"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "css-declaration-sorter": "^7.4.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "glob": "^13.0.6",
    "globals": "^17.13.0",
    "kiso.css": "^1.2.4",
    "postcss": "^8.5.31",
    "postcss-merge-at-rules": "^2.0.1",
    "postcss-sort-media-queries": "^6.7.1",
    "sass": "^1.106.1",
    "typescript": "^6.0.0",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "browserslist": [],
  "comments": {
    "security issues": "pnpm audit --audit-level high, (Low、Moderate、High、Critical)",
    "NOTE": ""
  }
}
